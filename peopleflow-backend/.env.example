# --- Required ---------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/peopleflow
ACCESS_TOKEN_SECRET_KEY=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET_KEY=change-me-to-a-different-long-random-string

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Dates (attendance days, leave ranges) are calculated in this timezone
TZ=Asia/Kolkata

# First admin, created on startup (or with `npm run seed`) if none exists
ADMIN_USERNAME=Administrator
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@12345

# --- Optional: email (credentials, salary slips, weekly report) -------------
# Without these, emails are logged to the console and temporary passwords are
# returned in the API response instead.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# --- Optional: Redis (caching + BullMQ queues) ------------------------------
# Without it, an in-memory cache is used and jobs run in-process.
REDIS_URL=

# --- Optional: Cloudinary (file uploads) ------------------------------------
# Without these, files are stored in ./uploads and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Check-ins after this time are marked late (HH:MM, server timezone)
OFFICE_START=09:30
